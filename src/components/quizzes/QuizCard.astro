---
import ProgressBar from '../shared/ProgressBar.astro';
import { QUIZ_KIND_LABELS, type QuizKind } from '../../content/quizKinds';

interface Props {
  quizId: string;
  kind: QuizKind;
  title: string;
  description: string;
  questionCount: number;
  href: string;
}

const { quizId, kind, title, description, questionCount, href } = Astro.props;
---
<a
  href={href}
  class="quiz-card surface animate-fade-in-up"
  id={`quiz-${quizId}`}
  data-quiz-id={quizId}
  data-quiz-kind={kind}
  data-question-count={questionCount}
>
  <div class="quiz-card__header">
    <h2 class="quiz-card__title">{title}</h2>
    <div class="quiz-card__badges">
      <span class={`badge quiz-card__kind quiz-card__kind--${kind}`}>{QUIZ_KIND_LABELS[kind]}</span>
      <span class="badge badge--muted quiz-card__count">{questionCount} preguntas</span>
    </div>
  </div>
  <p class="quiz-card__description">{description}</p>
  <div class="quiz-card__footer">
    <div class="quiz-card__progress-label">
      <span class="quiz-card__progress-text" data-progress-text>Sin comenzar</span>
      <span class="quiz-card__progress-count" data-progress-label>–</span>
    </div>
    <ProgressBar value={0} max={questionCount} id={`progress-${quizId}`} />
  </div>
</a>

<script>
  import type { QuizProgress } from '../quiz/quizStorage';
  import { loadStoredProgress } from './storedProgress';

  const STATUS_TEXT: Record<string, string> = {
    none: 'Sin comenzar',
    'in-progress': 'En progreso',
    retrying: 'Reintentando',
    completed: 'Completado',
  };

  function presentationKey(progress: QuizProgress): string {
    return progress.retrying ? 'retrying' : progress.status;
  }

  function renderCard(card: HTMLElement): void {
    const quizId = card.dataset.quizId!;
    const total = Number(card.dataset.questionCount);
    const progress = loadStoredProgress(quizId, total);

    const key = presentationKey(progress);
    card.dataset.progressStatus = key;

    const textEl = card.querySelector('[data-progress-text]');
    if (textEl) textEl.textContent = STATUS_TEXT[key];

    const countEl = card.querySelector('[data-progress-label]');
    if (countEl) countEl.textContent = progress.status === 'none' ? '–' : `${progress.confirmed} / ${total}`;

    renderProgressBar(quizId, progress);
  }

  function renderProgressBar(quizId: string, progress: QuizProgress): void {
    const fill = document.getElementById(`progress-${quizId}`)?.querySelector<HTMLElement>('.progress-fill');
    if (!fill) return;
    const pct = progress.total > 0 ? Math.round((progress.confirmed / progress.total) * 100) : 0;
    fill.style.width = `${pct}%`;
    fill.classList.toggle('progress-fill--complete', progress.status === 'completed');
  }

  document.querySelectorAll<HTMLElement>('[data-quiz-id]').forEach(renderCard);
</script>

<style>
  .quiz-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-xl);
    text-decoration: none;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .quiz-card[hidden] { display: none; }

  .quiz-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .quiz-card__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .quiz-card__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .quiz-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .quiz-card__kind--model {
    background: var(--color-accent-subtle);
    color: var(--color-accent-hover);
  }

  .quiz-card__kind--practice {
    background: var(--color-correct-bg);
    color: var(--color-correct);
  }

  .quiz-card__description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .quiz-card__footer { margin-top: auto; }

  .quiz-card__progress-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }

  .quiz-card__progress-text {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    font-weight: 500;
  }

  .quiz-card[data-progress-status="in-progress"] .quiz-card__progress-text {
    color: var(--color-accent-hover);
  }

  .quiz-card[data-progress-status="retrying"] .quiz-card__progress-text {
    color: var(--color-accent-hover);
  }

  .quiz-card[data-progress-status="retrying"] .quiz-card__progress-text::before {
    content: "↻ ";
  }

  .quiz-card[data-progress-status="completed"] .quiz-card__progress-text {
    color: var(--color-correct);
  }

  .quiz-card[data-progress-status="completed"] .quiz-card__progress-text::after {
    content: " ✓";
  }

  .quiz-card__progress-count {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }
</style>
