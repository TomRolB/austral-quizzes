---
interface Props {
  quizId: string;
  questionId: number;
  optionIndex: number;
  label: string;
  multiple: boolean;
}

const { quizId, questionId, optionIndex, label, multiple } = Astro.props;
---
<button
  class:list={['option-btn', { 'option-btn--multiple': multiple }]}
  id={`option-${quizId}-${questionId}-${optionIndex}`}
  data-question-id={questionId}
  data-option-index={optionIndex}
  aria-pressed="false"
>
  <span class="option-indicator" id={`indicator-${quizId}-${questionId}-${optionIndex}`}>
    <span class="dot"></span>
  </span>
  <span class="option-text">{label}</span>
  <span class="option-icon" id={`icon-${quizId}-${questionId}-${optionIndex}`}>
    <span class="icon-correct" style="display: none;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </span>
    <span class="icon-incorrect" style="display: none;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </span>
  </span>
</button>

<style>
  .option-btn {
    position: relative;
  }

  .option-indicator {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .option-btn:disabled .option-indicator {
    display: none;
  }

  .option-text {
    flex: 1;
  }

  .option-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-correct, .icon-incorrect {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .option-btn--correct .icon-correct {
    display: flex !important;
  }

  .option-btn--incorrect .icon-incorrect {
    display: flex !important;
  }

  .dot {
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-text-subtle);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .option-btn--multiple .dot {
    border-radius: 0.25rem;
  }

  .option-btn--selected .dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
