---
import QuestionOption from './QuestionOption.astro';
import QuestionResult from './QuestionResult.astro';
import { type Question, allowsMultipleAnswers, correctOptionLabels } from './question';

interface Props {
  quizId: string;
  question: Question;
  index: number;
}

const { quizId, question, index } = Astro.props;
const multiple = allowsMultipleAnswers(question);
---
<div
  class="question-card surface animate-fade-in-up"
  id={`question-${quizId}-${question.id}`}
  data-question-id={question.id}
  style={`animation-delay: ${Math.min(index * 0.04, 0.3)}s`}
>
  <div class="question-card__header" id={`qheader-${quizId}-${question.id}`}>
    <span class="question-number badge badge--accent">#{question.id}</span>
    <div class="question-card__prompt">
      <p class="question-card__text">{question.question}</p>
      {multiple && <p class="question-card__hint">Seleccioná todas las opciones correctas</p>}
    </div>
  </div>

  <div class="question-card__options">
    {question.options.map((option, optionIndex) => (
      <QuestionOption
        quizId={quizId}
        questionId={question.id}
        optionIndex={optionIndex}
        label={option}
        multiple={multiple}
      />
    ))}
  </div>

  {multiple && (
    <div class="question-card__confirm">
      <button
        class="btn btn--primary"
        id={`confirm-${quizId}-${question.id}`}
        data-action="confirm"
        data-question-id={question.id}
        disabled
      >
        Confirmar respuesta
      </button>
    </div>
  )}

  <QuestionResult quizId={quizId} questionId={question.id} correctLabels={correctOptionLabels(question)} />
</div>

<style>
  .question-card {
    overflow: hidden;
    transition: box-shadow var(--transition-base);
  }

  .question-card__header {
    padding: var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    background: var(--color-surface);
    transition: border-color var(--transition-base);
  }

  .question-card--correct .question-card__header {
    border-bottom-color: var(--color-correct-border);
  }

  .question-card--incorrect .question-card__header {
    border-bottom-color: var(--color-incorrect-border);
  }

  .question-number {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .question-card__prompt {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .question-card__text {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.55;
  }

  .question-card__hint {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-subtle);
  }

  .question-card__options {
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .question-card__confirm {
    padding: 0 var(--space-xl) var(--space-lg);
    display: flex;
    justify-content: flex-end;
  }

  .question-card__confirm button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
