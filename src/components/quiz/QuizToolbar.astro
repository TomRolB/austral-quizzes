---
interface Props {
  quizId: string;
}

const { quizId } = Astro.props;
---
<div class="quiz-toolbar">
  <button class="btn btn--secondary" data-action="reveal" id={`reveal-top-${quizId}`}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>
    Revelar respuestas
  </button>

  <button class="btn btn--ghost" data-action="retry-request" data-scope="toolbar" style="display:none">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
      <path d="M3 3v5h5"/>
    </svg>
    Volver a responder
  </button>
</div>

<style>
  .quiz-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }

  .quiz-toolbar .btn {
    padding: 0.4rem var(--space-md);
    font-size: 0.82rem;
  }
</style>
