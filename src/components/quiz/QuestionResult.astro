---
interface Props {
  quizId: string;
  questionId: number;
  correctLabels: string[];
}

const { quizId, questionId, correctLabels } = Astro.props;
---
<div class="question-card__result" id={`result-${quizId}-${questionId}`} aria-live="polite">
  <div class="result-banner result-banner--correct" data-banner-type="correct" style="display: none;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    <span>¡Respuesta correcta!</span>
  </div>
  <div class="result-banner result-banner--incorrect" data-banner-type="incorrect" style="display: none;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    <span>
      Incorrecto · {correctLabels.length > 1 ? 'Correctas' : 'Correcta'}:
      <strong>{correctLabels.join(' · ')}</strong>
    </span>
  </div>
</div>

<style>
  .question-card__result {
    padding: 0 var(--space-xl) var(--space-lg);
  }

  .result-banner {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    animation: fadeIn 0.2s ease;
  }

  .result-banner--correct {
    background: var(--color-correct-bg);
    color: var(--color-correct);
    border: 1px solid var(--color-correct-border);
  }

  .result-banner--incorrect {
    background: var(--color-incorrect-bg);
    color: var(--color-incorrect);
    border: 1px solid var(--color-incorrect-border);
  }
</style>
