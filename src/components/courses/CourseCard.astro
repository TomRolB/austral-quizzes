---
import ProgressBar from '../shared/ProgressBar.astro';

interface Props {
  courseId: string;
  courseName: string;
  courseIcon: string;
  quizCount: number;
  href: string;
}

const { courseId, courseName, courseIcon, quizCount, href } = Astro.props;
---
<a href={href} class="course-card surface animate-fade-in-up" id={`course-${courseId}`}>
  <div class="course-card__icon">{courseIcon}</div>
  <div class="course-card__body">
    <h2 class="course-card__name">{courseName}</h2>
    <p class="course-card__meta">
      <span class="badge badge--accent">{quizCount} {quizCount === 1 ? 'examen' : 'exámenes'}</span>
    </p>
  </div>
  <div class="course-card__arrow">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </div>
</a>

<style>
  .course-card {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-lg) var(--space-xl);
    text-decoration: none;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .course-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .course-card__icon {
    font-size: 2rem;
    flex-shrink: 0;
    width: 3rem;
    text-align: center;
  }

  .course-card__body { flex: 1; min-width: 0; }

  .course-card__name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .course-card__meta { display: flex; gap: var(--space-sm); }

  .course-card__arrow {
    color: var(--color-text-subtle);
    flex-shrink: 0;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .course-card:hover .course-card__arrow {
    color: var(--color-accent-hover);
    transform: translateX(3px);
  }
</style>
