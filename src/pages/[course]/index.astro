---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import QuizCard from '../../components/quizzes/QuizCard.astro';
import BackButton from '../../components/shared/BackButton.astro';

export async function getStaticPaths() {
  const allQuizzes = await getCollection('quizzes');

  const courseIds = [...new Set(allQuizzes.map(q => q.data.courseId))];

  return courseIds.map(courseId => {
    const courseQuizzes = allQuizzes.filter(q => q.data.courseId === courseId);
    const { courseName, courseIcon } = courseQuizzes[0].data;

    return {
      params: { course: courseId },
      props: { courseId, courseName, courseIcon, quizzes: courseQuizzes },
    };
  });
}

const { courseId, courseName, courseIcon, quizzes } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<PageLayout
  title={courseName}
  breadcrumbs={[
    { label: 'Inicio', href: base },
    { label: courseName },
  ]}
>
  <div class="course-page page-container--narrow">
    <div class="course-page__heading">
      <BackButton href={base} label="Todas las materias" />
      <div class="course-page__title-row">
        <span class="course-icon">{courseIcon}</span>
        <h1 class="course-page__title">{courseName}</h1>
      </div>
      <p class="course-page__meta">{quizzes.length} {quizzes.length === 1 ? 'examen disponible' : 'exámenes disponibles'}</p>
    </div>

    <div class="quiz-grid">
      {quizzes.map(quiz => (
        <QuizCard
          quizId={quiz.data.id}
          title={quiz.data.title}
          description={quiz.data.description}
          questionCount={quiz.data.questions.length}
          href={`${base}${courseId}/${quiz.data.id}`}
        />
      ))}
    </div>
  </div>
</PageLayout>

<style>
  .course-page { display: flex; flex-direction: column; gap: var(--space-xl); }

  .course-page__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .course-page__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .course-icon { font-size: 2rem; }

  .course-page__title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .course-page__meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .quiz-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }
</style>
